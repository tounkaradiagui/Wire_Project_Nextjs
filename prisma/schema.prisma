generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  id        String  @id @default(cuid())
  clerkId   String  @unique
  role      Role
  username  String  @unique
  firstName String
  lastName  String
  image     String?

  teacher   Teacher?
  parent    Parent?
  student   Student?
  admin     Admin?
  auditLogs AuditLog[]

  isActive  Boolean   @default(true)
  isBanned  Boolean   @default(false)
  bannedAt  DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id       String  @id
  username String  @unique
  email    String? @unique

  userProfileId String      @unique
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model Parent {
  id       String    @id
  username String    @unique
  name     String
  surname  String
  sex      UserSex
  email    String?   @unique
  phone    String    @unique
  address  String
  image    String?
  birthday DateTime?
  students Student[]

  userProfileId String      @unique
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model Student {
  id                String       @id
  username          String       @unique
  name              String
  surname           String
  email             String?      @unique
  phone             String?      @unique
  verificationToken String       @unique @default(cuid())
  cardExpiresAt     DateTime     @default(now())
  cardNumber        String       @unique @db.VarChar(7)
  address           String
  image             String?
  bloodType         String
  sex               UserSex
  birthday          DateTime?
  createdAt         DateTime     @default(now())
  parentId          String
  gradeId           Int
  classId           Int
  attendances       Attendance[]
  results           Result[]
  class             Class        @relation(fields: [classId], references: [id])
  grade             Grade        @relation(fields: [gradeId], references: [id])
  parent            Parent       @relation(fields: [parentId], references: [id])

  userProfileId String      @unique
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model Teacher {
  id             String           @id
  username       String           @unique
  name           String
  surname        String
  email          String?          @unique
  phone          String?          @unique
  address        String
  image          String?
  bloodType      String
  birthday       DateTime?
  sex            UserSex
  lessons        Lesson[]
  subjects       TeacherSubject[]
  teacherClasses TeacherClass[]
  sessions       Session[]
  results        Result[]
  userProfileId  String           @unique
  userProfile    UserProfile      @relation(fields: [userProfileId], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model Grade {
  id       Int       @id @default(autoincrement())
  level    Int       @unique
  name     String    @unique
  cycle    CycleEnum
  classes  Class[]
  students Student[]
}

model Class {
  id             Int            @id @default(autoincrement())
  name           String
  capacity       Int
  gradeId        Int
  announcements  Announcement[]
  grade          Grade          @relation(fields: [gradeId], references: [id])
  events         Event[]
  lessons        Lesson[]
  students       Student[]
  teacherClasses TeacherClass[]
  sessions       Session[]

  @@unique([name, gradeId])
}

model Subject {
  id          Int              @id @default(autoincrement())
  code        String?
  coefficient Float?
  name        String           @unique
  lessons     Lesson[]
  results     Result[]
  teachers    TeacherSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model TeacherSubject {
  teacherId String
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  @@id([teacherId, subjectId])
}

model TeacherClass {
  teacherId String
  classId   Int

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])

  @@id([teacherId, classId])
}

model Lesson {
  id          Int       @id @default(autoincrement())
  name        String
  duration    String?
  description String?
  startDate   DateTime?
  dueDate     DateTime?

  subjectId Int
  classId   Int
  teacherId String

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  assignments Assignment[]
  exams       Exam[]
  sessions    Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  results   Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  results   Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model Result {
  id Int @id @default(autoincrement())

  // NOTE
  score Float

  // RELATIONS PRINCIPALES
  studentId String
  subjectId Int
  teacherId String
  termId    Int

  // CONTEXTE (optionnel)
  examId       Int?
  assignmentId Int?

  // META
  appreciation String?
  rank         Int?

  // RELATIONS
  term    Term    @relation(fields: [termId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  exam       Exam?       @relation(fields: [examId], references: [id])
  assignment Assignment? @relation(fields: [assignmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime @default(now())
  isDeleted Boolean  @default(false)

  @@unique([studentId, examId])
  @@unique([studentId, assignmentId])
}

model Session {
  id        String   @id @default(uuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  room      String?

  lessonId  Int
  teacherId String
  classId   Int

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model Attendance {
  id        Int              @id @default(autoincrement())
  status    AttendanceStatus @default(PRESENT)
  comment   String?
  proofUrl  String?
  createdBy AttendanceActor  @default(TEACHER)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@unique([studentId, sessionId])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime
  description String?
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

model AuditLog {
  id String @id @default(cuid())

  // 🔥 Action principale
  action AuditAction

  // 🔍 Cible de l'action
  entityType String
  entityId   String?

  // 👤 Qui a fait l'action
  performedById String?
  performedBy   UserProfile? @relation(fields: [performedById], references: [id])

  role Role?

  // 🌐 Contexte technique
  ipAddress String?
  userAgent String?
  requestId String?

  // 🧠 Description lisible
  description String?

  // 📊 Données structurées
  metadata Json?

  // 🔄 Diff avant / après
  before Json?
  after  Json?

  // 🗑 Soft delete tracking
  isSoftDelete Boolean @default(false)

  // ⏱ Timestamp
  createdAt DateTime @default(now())

  // ⚡ Index pour performance
  @@index([createdAt])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([performedById])
  @@index([role])
}

model Term {
  id        Int      @id @default(autoincrement())
  name      String // "Trimestre 1"
  order     Int // 1, 2, 3
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean  @default(false)

  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])

  results Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolYear {
  id       Int     @id @default(autoincrement())
  name     String // "2025-2026"
  isActive Boolean @default(true)

  terms Term[]

  createdAt DateTime @default(now())
}

enum AuditAction {
  // USER
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  BAN_USER
  UNBAN_USER

  // STUDENT
  CREATE_STUDENT
  UPDATE_STUDENT
  DELETE_STUDENT

  // TEACHER
  CREATE_TEACHER
  UPDATE_TEACHER
  DELETE_TEACHER

  // PARENT
  CREATE_PARENT
  UPDATE_PARENT
  DELETE_PARENT

  // SUBJECT
  CREATE_SUBJECT
  UPDATE_SUBJECT
  DELETE_SUBJECT

  // LESSON
  CREATE_LESSON
  UPDATE_LESSON
  DELETE_LESSON

  // ASSIGNMENT
  CREATE_ASSIGNMENT
  UPDATE_ASSIGNMENT
  DELETE_ASSIGNMENT

  // EXAM
  CREATE_EXAM
  UPDATE_EXAM
  DELETE_EXAM

  // RESULT
  CREATE_RESULT
  UPDATE_RESULT
  DELETE_RESULT

  // SESSION
  CREATE_SESSION
  UPDATE_SESSION
  DELETE_SESSION

  // ATTENDANCE
  CREATE_ATTENDANCE
  UPDATE_ATTENDANCE
  DELETE_ATTENDANCE

  // SOFT DELETE
  SOFT_DELETE
  RESTORE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum UserSex {
  MALE
  FEMALE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceActor {
  TEACHER
  PARENT
  ADMIN
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum CycleEnum {
  FIRST
  SECOND
}
