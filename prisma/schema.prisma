generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ════════════════════════════════════════════════════════════════════════════
// SCHOOL — Racine du tenant multi-école
// ════════════════════════════════════════════════════════════════════════════

model School {
  // ── Identité ─────────────────────────────────────────────────────────────
  id   String @id @default(cuid())
  slug String @unique // URL-friendly, ex: "lycee-sainte-marie" → /ecoles/lycee-sainte-marie
  name String

  // ── Localisation ─────────────────────────────────────────────────────────
  city     String
  country  String
  address  String?
  timezone String  @default("Africa/Abidjan") // Pour gestion des horaires/séances

  // ── Contact ──────────────────────────────────────────────────────────────
  email   String?
  phone   String?
  website String?

  // Responsable de l'établissement
  contactName  String?
  contactEmail String?
  contactPhone String?

  // ── Médias ───────────────────────────────────────────────────────────────
  logoUrl   String? // Logo carré (affiché dans les cards)
  bannerUrl String? // Bannière large (affiché en header de la page école)

  // ── Description & informations publiques ─────────────────────────────────
  description String? @db.Text
  foundedYear Int? // Année de fondation
  maxStudents Int? // Capacité max selon le plan
  language    String  @default("fr") // Langue principale de l'école

  status     SchoolStatus @default(PENDING) // PENDING → doit être validée par super_admin
  isVerified Boolean      @default(false) // Validé par super_admin après SchoolRegistrationRequest

  // ── Paramètres internes (JSON flexible) ──────────────────────────────────
  // Ex: { "gradingScale": 20, "semesterMode": false, "allowParentMessages": true }
  settings Json?

  // ── Relations vers les entités scopées ───────────────────────────────────
  userProfiles              UserProfile[]
  admins                    Admin[]
  teachers                  Teacher[]
  students                  Student[]
  parents                   Parent[]
  classes                   Class[]
  grades                    Grade[]
  subjects                  Subject[]
  schoolYears               SchoolYear[]
  events                    Event[]
  announcements             Announcement[]
  teacherApplications       TeacherApplication[]
  subscriptions             Subscription[]
  schoolRegistrationRequest SchoolRegistrationRequest? // L'origine de la création de cette école

  // ── Soft delete / lifecycle ───────────────────────────────────────────────
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)
  schoolProvision SchoolProvision?

  @@index([status])
  @@index([slug])
}

model Subscription {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Plan choisi
  plan SubscriptionPlan @default(STANDARD)

  // Etat de l'abonnement
  status SubscriptionStatus @default(TRIAL)

  // Durée
  startsAt DateTime @default(now())
  endsAt   DateTime

  // Période d'essai
  trialEndsAt DateTime?

  // Prix payé
  amount Decimal? @db.Decimal(10, 2)

  currency String @default("USD")

  // Référence paiement
  transactionId String?

  invoiceNumber String?

  paymentProvider String?

  // Paiement automatique
  autoRenew Boolean @default(false)

  nextBillingDate DateTime?

  cancelAtPeriodEnd Boolean @default(false)

  // Création / modification
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  schoolProvision SchoolProvision?

  @@index([schoolId])
  @@index([status])
  @@index([plan])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum SubscriptionPlan {
  FREE // Plan gratuit (fonctionnalités limitées)
  STANDARD // Plan standard (fonctionnalités de base)
  PREMIUM // Toutes les fonctionnalités (bulletins avancés, stats, etc.)
  ENTREPRISE // Fonctionnalités plus avancées (API, intégrations, etc.)
}

enum SchoolStatus {
  PENDING // Demande reçue, en attente de validation super_admin
  ACTIVE // École opérationnelle
  SUSPENDED // Abonnement expiré ou violation
  INACTIVE // Fermée volontairement
}

// ════════════════════════════════════════════════════════════════════════════
// SCHOOL REGISTRATION REQUEST — Demande publique de création d'espace
// ════════════════════════════════════════════════════════════════════════════

model SchoolRegistrationRequest {
  id String @id @default(cuid())

  // ── Informations sur l'école demandée ─────────────────────────────────
  schoolName    String
  city          String
  country       String
  studentsCount Int?
  message       String? @db.Text

  // ── Contact du demandeur ─────────────────────────────────────────────
  contactName String
  email       String
  phone       String?

  // ── Traitement par le super_admin ────────────────────────────────────
  status     RequestStatus @default(PENDING)
  reviewedAt DateTime? // Quand le super_admin a traité la demande
  reviewNote String? // Note interne du super_admin (raison rejet, etc.)

  // ── École créée après validation ─────────────────────────────────────
  // Rempli si status = VALIDATED, pour tracer le lien entre la demande et l'école créée
  createdSchoolId String? @unique
  createdSchool   School? @relation(fields: [createdSchoolId], references: [id])

  // Qui a traité la demande
  processedById String?
  processedBy   UserProfile? @relation(fields: [processedById], references: [id])

  clerkUserId String?

  adminCreated Boolean @default(false)

  subscriptionCreated Boolean @default(false)

  completedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt       DateTime         @updatedAt
  schoolProvision SchoolProvision?
}

model SchoolProvision {
  id String @id @default(cuid())

  requestId String                    @unique
  request   SchoolRegistrationRequest @relation(fields: [requestId], references: [id])

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id])

  subscriptionId String?       @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  clerkUserId String

  generatedPassword String?

  completedAt DateTime?

  emailSent   Boolean   @default(false)
  emailSentAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum RequestStatus {
  PENDING
  VALIDATED
  REJECTED
}

// ════════════════════════════════════════════════════════════════════════════
// TEACHER APPLICATION — Candidature enseignant (soumise depuis la landing page)
// ════════════════════════════════════════════════════════════════════════════

model TeacherApplication {
  id String @id @default(cuid())

  // École cible (référence réelle si l'école est dans la plateforme)
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  // Informations du candidat
  fullName    String
  email       String
  phone       String
  coverLetter String @db.Text
  cvUrl       String
  cvFileName  String

  // Traitement
  status     ApplicationStatus @default(PENDING)
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt

  @@index([email])
  @@index([schoolId])
  @@index([status])
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

// ════════════════════════════════════════════════════════════════════════════
// USER PROFILE — Profil global lié à Clerk (toutes les entités en dépendent)
// ════════════════════════════════════════════════════════════════════════════

model UserProfile {
  id        String  @id @default(cuid())
  clerkId   String  @unique
  role      Role
  username  String  @unique
  email     String? @unique
  firstName String
  lastName  String
  image     String?

  // Clé du tenant — null UNIQUEMENT pour SUPER_ADMIN (cross-école)
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  teacher   Teacher?
  parent    Parent?
  student   Student?
  admin     Admin?
  auditLogs AuditLog[]

  isActive  Boolean   @default(true)
  isBanned  Boolean   @default(false)
  bannedAt  DateTime?
  deletedAt DateTime?

  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  schoolRegistrationRequests SchoolRegistrationRequest[]

  @@index([schoolId])
  @@index([role])
}

// ════════════════════════════════════════════════════════════════════════════
// ADMIN — Administrateur d'une école (≠ SUPER_ADMIN)
// ════════════════════════════════════════════════════════════════════════════

model Admin {
  id       String  @id // = clerkId
  username String  @unique
  name     String?
  surname  String?
  email    String? @unique
  phone    String?

  // 🆕
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  userProfileId String      @unique
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([schoolId])
}

// ════════════════════════════════════════════════════════════════════════════
// PARENT
// ════════════════════════════════════════════════════════════════════════════

model Parent {
  id       String    @id
  username String    @unique
  name     String
  surname  String
  sex      UserSex
  email    String?   @unique
  phone    String    @unique
  address  String
  image    String?
  birthday DateTime?
  students Student[]

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  userProfileId String      @unique
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([schoolId])
}

// ════════════════════════════════════════════════════════════════════════════
// STUDENT
// ════════════════════════════════════════════════════════════════════════════

model Student {
  id                String    @id
  username          String    @unique
  name              String
  surname           String
  email             String?   @unique
  phone             String?   @unique
  verificationToken String    @unique @default(cuid())
  cardExpiresAt     DateTime  @default(now())
  cardNumber        String    @unique @db.VarChar(7)
  address           String
  image             String?
  bloodType         String
  sex               UserSex
  birthday          DateTime?
  parentId          String
  gradeId           Int
  classId           Int

  // 🆕
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  attendances Attendance[]
  results     Result[]
  reportCards ReportCard[]
  class       Class        @relation(fields: [classId], references: [id])
  grade       Grade        @relation(fields: [gradeId], references: [id])
  parent      Parent       @relation(fields: [parentId], references: [id])

  userProfileId String      @unique
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([schoolId])
  @@index([classId])
  @@index([gradeId])
}

// ════════════════════════════════════════════════════════════════════════════
// TEACHER
// ════════════════════════════════════════════════════════════════════════════

model Teacher {
  id            String    @id
  username      String    @unique
  name          String
  surname       String
  email         String?   @unique
  phone         String?   @unique
  address       String
  image         String?
  bloodType     String
  birthday      DateTime?
  userProfileId String    @unique

  // 🆕
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  sex            UserSex
  lessons        Lesson[]
  subjects       TeacherSubject[]
  teacherClasses TeacherClass[]
  sessions       Session[]
  results        Result[]
  subjectReports SubjectReport[]

  userProfile UserProfile @relation(fields: [userProfileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([schoolId])
}

// ════════════════════════════════════════════════════════════════════════════
// GRADE — Niveau scolaire (scopé par école)
// ════════════════════════════════════════════════════════════════════════════

model Grade {
  id       Int       @id @default(autoincrement())
  level    Int
  name     String
  cycle    CycleEnum
  classes  Class[]
  students Student[]

  // Level et name ne sont plus globalement uniques : deux écoles peuvent avoir "6ème"
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now()) @updatedAt
  deletedAt DateTime?
  isDeleted Boolean?  @default(false)

  @@unique([level, schoolId])
  @@unique([name, schoolId])
  @@index([schoolId])
}

// ════════════════════════════════════════════════════════════════════════════
// CLASS — Classe (scopée via Grade → School, + index direct)
// ════════════════════════════════════════════════════════════════════════════

model Class {
  id             Int            @id @default(autoincrement())
  name           String
  capacity       Int
  gradeId        Int
  announcements  Announcement[]
  grade          Grade          @relation(fields: [gradeId], references: [id])
  events         Event[]
  lessons        Lesson[]
  students       Student[]
  teacherClasses TeacherClass[]
  sessions       Session[]
  reportCards    ReportCard[]

  // 🆕 — index direct pour les requêtes admin sans passer par Grade
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@unique([name, gradeId]) // Unicité déjà scopée via gradeId → schoolId
  @@index([schoolId])
}

// ════════════════════════════════════════════════════════════════════════════
// SUBJECT — Matière (scopée par école)
// ════════════════════════════════════════════════════════════════════════════

model Subject {
  id          Int     @id @default(autoincrement())
  code        String?
  coefficient Float?
  name        String

  // 🆕 — deux écoles peuvent avoir une matière "Mathématiques"
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  lessons        Lesson[]
  results        Result[]
  teachers       TeacherSubject[]
  subjectReports SubjectReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@unique([name, schoolId])
  @@index([schoolId])
}

// ════════════════════════════════════════════════════════════════════════════
// SCHOOL YEAR — Année scolaire (scopée par école)
// ════════════════════════════════════════════════════════════════════════════

model SchoolYear {
  id       Int     @id @default(autoincrement())
  name     String // "2025-2026"
  isActive Boolean @default(true)

  // 🆕
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  terms       Term[]
  reportCards ReportCard[]

  createdAt DateTime @default(now())

  @@unique([name, schoolId]) // Une seule année "2025-2026" par école
  @@index([schoolId])
}

// ════════════════════════════════════════════════════════════════════════════
// EVENT & ANNOUNCEMENT — Scopés par école (+ classe optionnelle)
// ════════════════════════════════════════════════════════════════════════════

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])

  // 🆕
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime
  description String?
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])

  // 🆕
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

// ════════════════════════════════════════════════════════════════════════════
// MODÈLES INCHANGÉS (héritage du tenant via leurs relations)
// ════════════════════════════════════════════════════════════════════════════
// Term, Lesson, Exam, Assignment, Result, Session, Attendance,
// ReportCard, SubjectReport, TeacherSubject, TeacherClass, AuditLog
// n'ont PAS de schoolId direct : ils héritent du scope via
// Teacher.schoolId / Class.schoolId / Subject.schoolId etc.
// Ajouter schoolId dessus serait redondant sauf pour du reporting cross-école
// côté super_admin (peut être ajouté plus tard si besoin de perf).

model TeacherSubject {
  teacherId String
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  @@id([teacherId, subjectId])
}

model TeacherClass {
  teacherId String
  classId   Int

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])

  @@id([teacherId, classId])
}

model Lesson {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  startDate   DateTime?
  dueDate     DateTime?

  weekDay   Int? // 0 = dimanche, 1 = lundi ...
  startTime Int? // heure uniquement
  endTime   Int?

  subjectId Int
  classId   Int
  teacherId String

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  assignments Assignment[]
  exams       Exam[]
  sessions    Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  results   Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  results   Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model Result {
  id Int @id @default(autoincrement())

  score Float

  studentId String
  subjectId Int
  teacherId String
  termId    Int

  examId       Int?
  assignmentId Int?

  appreciation String?
  rank         Int?

  term       Term        @relation(fields: [termId], references: [id])
  student    Student     @relation(fields: [studentId], references: [id])
  subject    Subject     @relation(fields: [subjectId], references: [id])
  teacher    Teacher     @relation(fields: [teacherId], references: [id])
  exam       Exam?       @relation(fields: [examId], references: [id])
  assignment Assignment? @relation(fields: [assignmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime @default(now())
  isDeleted Boolean  @default(false)

  @@unique([studentId, examId])
  @@unique([studentId, assignmentId])
}

model Session {
  id        String   @id @default(uuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  room      String?

  lessonId  Int
  teacherId String
  classId   Int

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)
}

model Attendance {
  id        Int              @id @default(autoincrement())
  status    AttendanceStatus @default(PRESENT)
  comment   String?
  proofUrl  String?
  createdBy AttendanceActor  @default(TEACHER)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@unique([studentId, sessionId])
}

model Term {
  id        Int      @id @default(autoincrement())
  name      String
  order     Int
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean  @default(false)

  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])

  results     Result[]
  reportCards ReportCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportCard {
  id           Int    @id @default(autoincrement())
  studentId    String
  classId      Int
  termId       Int
  schoolYearId Int

  generalAverage    Float
  rank              Int
  totalStudents     Int
  appreciation      String?
  decision          String?
  status            ReportCardStatus @default(DRAFT)
  generatedAt       DateTime?
  closedAt          DateTime?
  publishedAt       DateTime?
  totalCoefficients Float?
  totalPoints       Float?
  classHighest      Float?
  classLowest       Float?
  classAverage      Float?

  student    Student    @relation(fields: [studentId], references: [id])
  class      Class      @relation(fields: [classId], references: [id])
  term       Term       @relation(fields: [termId], references: [id])
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  subjectReports SubjectReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, termId])
}

model SubjectReport {
  id           Int    @id @default(autoincrement())
  reportCardId Int
  subjectId    Int
  teacherId    String

  coefficient     Float
  examScore       Float?
  assignmentScore Float?
  finalAverage    Float
  continuousScore Float?
  product         Float?
  classMin        Float?
  classMax        Float?
  classAverage    Float?
  appreciation    String?
  rank            Int?

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id])
  teacher    Teacher    @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportCardId, subjectId])
}

model AuditLog {
  id String @id @default(cuid())

  action AuditAction

  entityType String
  entityId   String?

  performedById String?
  performedBy   UserProfile? @relation(fields: [performedById], references: [id])

  role Role?

  ipAddress String?
  userAgent String?
  requestId String?

  description String?
  metadata    Json?
  before      Json?
  after       Json?

  isSoftDelete Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([performedById])
  @@index([role])
}

// ════════════════════════════════════════════════════════════════════════════
// ENUMS
// ════════════════════════════════════════════════════════════════════════════

enum ReportCardStatus {
  DRAFT
  GENERATED
  VALIDATED
  PUBLISHED
}

enum AuditAction {
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  BAN_USER
  UNBAN_USER

  CREATE_STUDENT
  UPDATE_STUDENT
  DELETE_STUDENT

  CREATE_TEACHER
  UPDATE_TEACHER
  DELETE_TEACHER

  APPROVE_SCHOOL_REQUEST
  CREATE_ADMIN
  CREATE_SUBSCRIPTION

  CREATE_PARENT
  UPDATE_PARENT
  DELETE_PARENT

  CREATE_SUBJECT
  UPDATE_SUBJECT
  DELETE_SUBJECT

  CREATE_CLASS
  UPDATE_CLASS
  DELETE_CLASS

  CREATE_LESSON
  UPDATE_LESSON
  DELETE_LESSON

  CREATE_ASSIGNMENT
  UPDATE_ASSIGNMENT
  DELETE_ASSIGNMENT

  CREATE_EXAM
  UPDATE_EXAM
  DELETE_EXAM

